; Godot 4.4 项目文件

config_version=5

[application]

config/name="七日杀 口袋版"
config/description="个人自用的七日杀小游戏，素材来自本地 assets/ 目录"
run/main_scene="res://scenes/boot.tscn"
run/max_fps=60
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
Assets="*res://scripts/asset_db.gd"
Sfx="*res://scripts/sfx.gd"
Data="*res://scripts/data.gd"
Status="*res://scripts/status_effects.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true,
"process/size_limit": 1024
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
scaling_3d/mode=0
scaling_3d/scale=0.7
